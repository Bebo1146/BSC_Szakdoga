<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Do not inherit corporate/machine/user feeds -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Optional: avoid VS offline/cache sources too -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>